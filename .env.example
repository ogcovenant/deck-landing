# Set to your actual public deployment origin for canonical URLs and sitemap.
NEXT_PUBLIC_SITE_URL=

# Server-only HTTPS endpoint. Must durably persist signup details and return
# JSON { "accepted": true } only after acceptance (including safe duplicates).
# The endpoint must implement rate limiting and Idempotency-Key handling.
WAITLIST_WEBHOOK_URL=
WAITLIST_WEBHOOK_TOKEN=

# Optional verified public contact email. Never a guessed address.
CONTACT_EMAIL=
