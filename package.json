{
  "name": "deck-cards",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:browser": "node scripts/browser-review.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "social:generate": "python3 scripts/generate-social-image.py"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "framer-motion": "13.4.4",
    "lucide-react": "0.556.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "playwright": "1.62.1"
  }
}
